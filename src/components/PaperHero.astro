---
import Picture from "./Picture.astro";

interface Props {
  image: ImageMetadata;
  alt: string;
  caption?: string;
}

const { image, alt, caption } = Astro.props;
---

<section class="not-prose mb-14">
  <Picture src={image} alt={alt} priority />
  {caption && (
    <p class="mx-auto mt-3 max-w-4xl text-center text-sm text-zinc-600 dark:text-zinc-400">
      {caption}
    </p>
  )}
</section>
