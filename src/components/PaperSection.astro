---
interface Props {
  title: string;
  eyebrow?: string;
}

const { title, eyebrow } = Astro.props;
---

<section class="my-16 scroll-mt-8">
  {eyebrow && (
    <p class="not-prose mb-2 text-sm font-semibold uppercase tracking-widest text-blue-700 dark:text-blue-300">
      {eyebrow}
    </p>
  )}
  <h2 class="mb-6">{title}</h2>
  <slot />
</section>
