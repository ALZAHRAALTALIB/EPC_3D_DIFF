---
type Column = {
  key: string;
  label: string;
  align?: "left" | "center" | "right";
};

type Row = Record<string, string>;

interface Props {
  columns: Column[];
  rows: Row[];
  highlight?: string;
}

const { columns, rows, highlight } = Astro.props;

const alignment = (align: Column["align"] = "left") =>
  align === "right" ? "text-right" : align === "center" ? "text-center" : "text-left";
---

<div class="not-prose my-8 overflow-x-auto rounded-xl border border-zinc-200 dark:border-zinc-800">
  <table class="w-full min-w-[40rem] border-collapse text-sm">
    <thead class="bg-zinc-100 dark:bg-zinc-800">
      <tr>
        {
          columns.map((column) => (
            <th class={`px-4 py-3 font-semibold ${alignment(column.align)}`}>
              {column.label}
            </th>
          ))
        }
      </tr>
    </thead>

    <tbody>
      {
        rows.map((row) => (
          <tr
            class:list={[
              "border-t border-zinc-200 dark:border-zinc-800",
              highlight && row[columns[0].key] === highlight
                ? "bg-blue-50 font-semibold dark:bg-blue-950/30"
                : "",
            ]}
          >
            {
              columns.map((column) => (
                <td class={`px-4 py-3 ${alignment(column.align)}`}>
                  {row[column.key]}
                </td>
              ))
            }
          </tr>
        ))
      }
    </tbody>
  </table>
</div>
