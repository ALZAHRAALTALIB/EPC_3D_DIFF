---
import { Icon } from "astro-icon/components";

type Author = {
  name: string;
  url?: string;
  notes?: string[];
};

type Affiliation = {
  symbol: string;
  text: string;
};

type Note = {
  symbol: string;
  text: string;
};

type Link = {
  url: string;
  name: string;
  icon?: string;
};

interface Props {
  title: string;
  authors: Author[];
  affiliations?: Affiliation[];
  conference?: string;
  notes?: Note[];
  links?: Link[];
}

const {
  title,
  authors,
  affiliations = [],
  conference,
  notes = [],
  links = [],
} = Astro.props;

const hasBackground = Astro.slots.has("background");
---

<header
  class:list={[
    "full-bleed relative mb-12",
    hasBackground && "-mt-16 pt-24 pb-28",
  ]}
>
  {
    hasBackground && (
      <div class="cover absolute inset-0 z-0 overflow-hidden">
        <slot name="background" />
        <div class="absolute inset-0 bg-black/40" />
      </div>
    )
  }

  <div
    class:list={[
      "relative z-10 mx-auto flex w-full max-w-7xl flex-col items-center px-6 text-center",
      hasBackground
        ? "gap-8 text-white prose-headings:text-white [text-shadow:0_0_8px_rgba(0,0,0,0.6)]"
        : "gap-6",
    ]}
  >
    <h1 class="my-0 max-w-7xl text-4xl font-medium leading-tight sm:text-5xl lg:text-6xl">
      {title}
    </h1>

    <div class="flex w-full flex-wrap justify-center gap-x-3 gap-y-2 text-lg sm:text-xl">
      {
        authors.map((author, index) => (
          <>
            <span class="whitespace-nowrap">
              {author.url ? (
                <a
                  href={author.url}
                  target="_blank"
                  rel="noopener noreferrer"
                  class:list={[
                    hasBackground
                      ? "not-prose text-blue-200 underline decoration-dashed underline-offset-4 hover:text-blue-100 hover:decoration-solid"
                      : "underline decoration-dashed underline-offset-4 hover:decoration-solid",
                  ]}
                >
                  {author.name}
                </a>
              ) : (
                author.name
              )}
              {author.notes?.length ? (
                <sup class="ml-0.5 text-sm">{author.notes.join(",")}</sup>
              ) : null}
            </span>
            {index < authors.length - 1 && <span aria-hidden="true">·</span>}
          </>
        ))
      }
    </div>

    {
      affiliations.length > 0 && (
        <div class="w-full max-w-6xl text-center text-sm leading-relaxed sm:text-base">
          {affiliations.map((affiliation, index) => (
            <>
              <span class="whitespace-nowrap">
                <sup class="mr-0.5">{affiliation.symbol}</sup>
                {affiliation.text}
              </span>
              {index < affiliations.length - 1 && (
                <span class="mx-2" aria-hidden="true">·</span>
              )}
            </>
          ))}
        </div>
      )
    }

    {conference && <div class="text-base font-medium">{conference}</div>}

    {
      notes.length > 0 && (
        <div class="max-w-5xl text-center text-sm">
          {notes.map((note, index) => (
            <span>
              <sup>{note.symbol}</sup>
              {note.text}
              {index < notes.length - 1 ? " · " : ""}
            </span>
          ))}
        </div>
      )
    }

    {
      links.length > 0 && (
        <div class="not-prose flex flex-row flex-wrap justify-center gap-2">
          {links.map((link) => (
            <a
              href={link.url}
              target="_blank"
              rel="noopener noreferrer"
              class:list={[
                "flex flex-row items-center gap-2 rounded-full px-5 py-2 text-lg hover:no-underline",
                hasBackground
                  ? "bg-white text-zinc-800 shadow-[0_0_8px_rgba(0,0,0,0.6)] hover:bg-zinc-200"
                  : "bg-zinc-800 text-white hover:bg-black dark:bg-zinc-200 dark:text-zinc-900 dark:hover:bg-zinc-50",
              ]}
            >
              {link.icon && <Icon name={link.icon} />}
              <span>{link.name}</span>
            </a>
          ))}
        </div>
      )
    }
  </div>
</header>

<style>
  .cover :global(:is(picture, img, video)) {
    position: absolute;
    inset: 0;
    margin: 0;
    width: 100%;
    height: 100%;
    max-width: none;
    max-height: none;
    object-fit: cover;
    border-radius: 0;
  }
</style>
