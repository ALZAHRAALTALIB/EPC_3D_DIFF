---
import { Icon } from "astro-icon/components";

type Author = {
  name: string;
  url?: string;
  institution?: string;
  notes?: string[];
  newRow?: boolean;
};

type Note = {
  symbol: string;
  text: string;
};

type Link = {
  url: string;
  name: string;
  icon?: string;
};

interface Props {
  title: string;
  authors: Author[];
  conference?: string;
  notes?: Note[];
  links?: Link[];
}

const { title, authors, conference, notes, links } = Astro.props;
const hasBackground = Astro.slots.has("background");
---

<header
  class:list={[
    "full-bleed relative mb-0 overflow-hidden",
    hasBackground
      ? "-mt-16 pt-14 pb-10 lg:pt-16 lg:pb-12"
      : "border-b border-emerald-100/70 bg-gradient-to-br from-emerald-50 via-white to-teal-50 py-14 dark:border-zinc-800",
  ]}
>
  {
    hasBackground && (
      <div class="cover absolute inset-0 z-0 overflow-hidden">
        <slot name="background" />
        <div class="absolute inset-0 bg-[linear-gradient(180deg,rgba(4,47,38,0.10),rgba(4,47,38,0.22))]" />
      </div>
    )
  }

  <div
    class:list={[
      "relative z-10 mx-auto flex max-w-7xl flex-col items-center px-6 text-center",
      hasBackground ? "gap-5 text-white prose-headings:text-white" : "gap-5",
    ]}
  >
    <div class="hero-badge-row not-prose flex flex-wrap items-center justify-center gap-3">
      {conference && (
        <div class="rounded-full border border-emerald-800/15 bg-white/72 px-4 py-1.5 text-sm font-semibold tracking-wide text-emerald-950 shadow-sm backdrop-blur-md">
          {conference}
        </div>
      )}
      <div class="rounded-full border border-emerald-700/15 bg-emerald-50/78 px-4 py-1.5 text-sm font-medium text-emerald-900 backdrop-blur-md">
        Project Page
      </div>
    </div>

    <h1 class="hero-title my-0 max-w-6xl text-balance text-3xl font-semibold leading-[1.08] tracking-tight text-white sm:text-4xl lg:text-5xl">
      {title}
    </h1>

    <div class="author-grid not-prose flex max-w-6xl flex-row flex-wrap justify-center gap-x-8 gap-y-3">
      {
        authors.map((author) => (
          <>
            {author.newRow && <span class="author-row-break" aria-hidden="true"></span>}
            <div class="flex items-center text-center">
              <div class="text-base font-medium sm:text-lg">
                {author.url ? (
                  <a
                    class:list={[
                      hasBackground &&
                        "text-white underline decoration-white/45 underline-offset-4 transition hover:text-emerald-50 hover:decoration-white",
                    ]}
                    href={author.url}
                  >
                    {author.name}
                  </a>
                ) : (
                  author.name
                )}
                {author.notes && (
                  <sup class="ml-0.5 text-sm sm:text-base">
                    {author.notes.map(
                      (note, index, array) =>
                        note + (index < array.length - 1 ? "," : ""),
                    )}
                  </sup>
                )}
              </div>
            </div>
          </>
        ))
      }
    </div>

    {
      notes && (
        <div class="hero-notes max-w-5xl text-center text-xs leading-relaxed text-white/90 sm:text-sm">
          {
            notes.map((note, index, array) => (
              <span>
                <sup class="text-white">{note.symbol}</sup>{note.text}
                {index < array.length - 1 ? " · " : ""}
              </span>
            ))
          }
        </div>
      )
    }

    {
      links && (
        <div class="not-prose flex flex-row flex-wrap justify-center gap-3 pt-1">
          {links.map((link) => (
            <a
              href={link.url}
              class:list={[
                "hero-link flex flex-row items-center gap-2 rounded-full px-4 py-2 text-sm font-medium transition hover:no-underline sm:text-base",
                hasBackground
                  ? "border border-emerald-900/10 bg-emerald-900 text-white shadow-[0_10px_30px_rgba(6,78,59,0.16)] hover:bg-emerald-800"
                  : "bg-emerald-800 text-white hover:bg-emerald-950",
              ]}
            >
              {link.icon && <Icon name={link.icon} />}
              <span>{link.name}</span>
            </a>
          ))}
        </div>
      )
    }
  </div>
</header>

<style>
  .cover :global(:is(picture, img, video, .hero-background, .hero-background *)) {
    margin: 0;
  }

  .cover :global(img) {
    position: absolute;
    max-width: none;
  }

  .author-row-break {
    flex-basis: 100%;
    width: 0;
    height: 0;
  }
</style>
