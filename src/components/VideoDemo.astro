---
import Video from "./Video.astro";

interface Props {
  src: string;
  title?: string;
}

const { src, title } = Astro.props;
---

<figure class="not-prose my-8">
  <Video src={src} controls autoplay={false} />
  {title && (
    <figcaption class="mt-2 text-center text-sm text-zinc-600 dark:text-zinc-400">
      {title}
    </figcaption>
  )}
</figure>
