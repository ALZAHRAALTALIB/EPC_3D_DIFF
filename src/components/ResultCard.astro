---
interface Props {
  label: string;
  value: string;
  detail?: string;
}

const { label, value, detail } = Astro.props;
---

<div class="not-prose rounded-2xl border border-zinc-200 bg-zinc-50 p-6 text-center shadow-sm dark:border-zinc-800 dark:bg-zinc-900">
  <div class="text-sm font-medium text-zinc-500 dark:text-zinc-400">{label}</div>
  <div class="mt-2 text-3xl font-semibold tracking-tight">{value}</div>
  {detail && <div class="mt-2 text-sm text-zinc-600 dark:text-zinc-400">{detail}</div>}
</div>
